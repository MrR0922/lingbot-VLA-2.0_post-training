@@ -277,6 +277,31 @@ done
 
 echo -e "\033[32m${num_slots} inference servers started, PIDs saved to ${inference_pid_file}\033[0m"
 
+# Loading all HF shards can take several minutes. Do not consume task retries
+# until every websocket server is actually accepting connections.
+echo -e "\033[36mWaiting for all inference ports to become ready...\033[0m"
+for slot in $(seq 0 $((num_slots-1))); do
+    port=$(( start_port + slot ))
+    ready=false
+    for attempt in $(seq 1 180); do
+        if (echo > "/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
+            ready=true
+            break
+        fi
+        pid=$(sed -n "$((slot+1))p" "$inference_pid_file")
+        if ! kill -0 "$pid" 2>/dev/null; then
+            echo -e "\033[31mInference server on port ${port} exited before becoming ready.\033[0m"
+            exit 1
+        fi
+        sleep 5
+    done
+    if [ "$ready" != true ]; then
+        echo -e "\033[31mTimeout waiting for inference server on port ${port}.\033[0m"
+        exit 1
+    fi
+done
+echo -e "\033[32mAll inference ports ready.\033[0m"
+
 # Record each slot's inference server PID for on-demand shutdown
 declare -a inference_pids=()
 for slot in $(seq 0 $((num_slots-1))); do
